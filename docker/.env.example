# Copy this file to `.env` (in this same docker/ directory) and fill in the
# values below for YOUR machine. .env is gitignored -- every clone of this
# repo generates its own.
#
# From this docker/ directory, you can generate the whole thing in one go:
#
#   printf 'PROJECT_ROOT=%s\nUID=%s\nGID=%s\n' "$(cd .. && pwd)" "$(id -u)" "$(id -g)" > .env
#
# PROJECT_ROOT: the absolute path of the project root on your machine --
# i.e. the directory that contains this repo's data/ folder (one level up
# from here). Has to be an absolute path, not a relative one: it's used both
# as the container-side bind-mount target in docker-compose.yml and has to
# exactly match the absolute path src/transform.py computes at runtime via
# Path(__file__).resolve().parent.parent, since the driver (running on the
# host) resolves spark.read/write paths locally -- see the comment block at
# the top of docker-compose.yml for why.
PROJECT_ROOT=/path/to/your/pga-tour-pyspark-pipeline

# UID / GID: your host user's numeric user/group id, used to run the Spark
# containers as you instead of the image's baked-in uid -- otherwise
# spark.write's driver-created output directories (owned by you, on the
# host) and the container's executor-created files inside them (owned by a
# different uid) clash on permissions. Get these with `id -u` / `id -g` --
# don't type numbers by hand, and note bash's own $UID/$GID shell variables
# are NOT reliably exported to docker compose's environment, so always
# generate this file with the `id -u`/`id -g` command above rather than
# relying on shell variable expansion.
UID=1000
GID=1000
