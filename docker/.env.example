# Copy this file to `.env` (in this same docker/ directory) and set
# PROJECT_ROOT to the absolute path of the project root on YOUR machine --
# i.e. the directory that contains this repo's data/ folder (one level up
# from here).
#
# This has to be an absolute path, not a relative one: it's used both as
# the container-side bind-mount target in docker-compose.yml and has to
# exactly match the absolute path src/transform.py computes at runtime via
# Path(__file__).resolve().parent.parent, since the driver (running on the
# host) resolves spark.read/write paths locally -- see the comment block at
# the top of docker-compose.yml for why.
#
# From this docker/ directory, you can generate it automatically:
#
#   echo "PROJECT_ROOT=$(cd .. && pwd)" > .env
#
# .env is gitignored -- every clone of this repo sets its own.
PROJECT_ROOT=/path/to/your/pga-tour-pyspark-pipeline
